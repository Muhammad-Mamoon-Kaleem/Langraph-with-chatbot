# PostgreSQL (LangGraph checkpointer)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/chatbot

# Redis (RQ job queue)
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_NAME=llm

# Ollama
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.1

# Queue / pool settings (Step 3+)
LLM_POOL_SIZE=3
LLM_MAX_CONCURRENT=2
LLM_JOB_TIMEOUT=120

# Default conversation thread
DEFAULT_THREAD_ID=user-123

# API server
API_HOST=127.0.0.1
API_PORT=8000
